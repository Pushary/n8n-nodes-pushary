{
  "name": "Ask a customer before releasing an order with Pushary",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "trusted-action",
      "name": "Trusted Action",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({operationId: \"order-123:release:v1\", action: {name: \"release_order\", orderId: \"order-123\", quantity: 2}, deadline: $now.plus({hours: 1}).toMillis()}) }}",
        "options": {}
      }
    },
    {
      "id": "create-decision",
      "name": "Create Decision",
      "type": "n8n-nodes-pushary.pushary",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "decision",
        "operation": "create",
        "operationId": "={{ $json.operationId }}",
        "action": "={{ JSON.stringify($json.action) }}",
        "question": "={{ \"Release \" + $json.action.quantity + \" items for \" + $json.action.orderId + \"?\" }}",
        "expiresInSeconds": 3600
      }
    },
    {
      "id": "check-approval",
      "name": "Check Approval",
      "type": "n8n-nodes-pushary.pushary",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "decision",
        "operation": "check",
        "decisionId": "={{ $(\"Create Decision\").first().json.decisionId }}",
        "operationId": "={{ $(\"Trusted Action\").first().json.operationId }}",
        "action": "={{ JSON.stringify($(\"Trusted Action\").first().json.action) }}"
      }
    },
    {
      "id": "approved",
      "name": "Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Approved",
              "leftValue": "={{ $json.approved === true && $now.toMillis() < $(\"Trusted Action\").first().json.deadline }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "simulated-action",
      "name": "Simulated Action",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        -120
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ simulated: true, wouldExecute: $json.action, idempotencyKey: $json.operationId }) }}",
        "options": {}
      }
    },
    {
      "id": "still-pending",
      "name": "Still Pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Still Pending",
              "leftValue": "={{ $json.status === \"pending\" && $now.toMillis() < $(\"Trusted Action\").first().json.deadline }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1440,
        120
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "minutes"
      }
    },
    {
      "id": "not-approved",
      "name": "Not Approved",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "errorMessage": "Decision denied, expired, cancelled, or polling deadline reached. No action executed."
      }
    },
    {
      "id": "set-up-the-test",
      "name": "Set up the test",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## Before you run\nInstall the verified Pushary node (0.3.1 or later). Select the same Pushary Decision API credential on Create Decision and Check Approval. Use a Partner key and an enrolled test customer. Running this sends a real question.",
        "width": 490,
        "height": 215
      }
    },
    {
      "id": "read-the-result",
      "name": "Read the result",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        -430
      ],
      "parameters": {
        "content": "## Try an approval and a denial\nApprove the first request to see the simulated order release. For a separate decision, change the operation ID in Trusted Action and run again. Deny it to end the workflow. A pending decision is checked every two minutes for up to one hour. No order is shipped.",
        "width": 490,
        "height": 215
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Trusted Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trusted Action": {
      "main": [
        [
          {
            "node": "Create Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Decision": {
      "main": [
        [
          {
            "node": "Check Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Approval": {
      "main": [
        [
          {
            "node": "Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved": {
      "main": [
        [
          {
            "node": "Simulated Action",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Still Pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still Pending": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Check Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
